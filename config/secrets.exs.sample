import Config

# Zone-centric format (recommended for multiple records)
# Supports multiple zones, each with multiple records
# Records without an :ip key use auto-detected public IP

config :update_dns, :zones, [
  %{
    zone_id: "<your_zone_id>",
    api_token: "<your_api_token>",
    records: [
      %{name: "home.example.com"},                     # Uses auto-detected IP
      %{name: "vpn.example.com"},                      # Uses auto-detected IP
      %{name: "internal.example.com", ip: "10.0.0.5"}  # Uses manual IP
    ]
  }
  # Add more zones here for different domains/accounts
]

# Legacy single-record format (still supported)
# Uncomment below and comment out :zones config above to use
#
# config :update_dns, :cloudflare,
#   zone_id: "<your_zone_id>",
#   api_token: "<your_api_token>",
#   record_name: "<your.domain.com>"
